  <div class="max-w-4xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-[var(--color-text-lighter)]">
    <p>&copy; {currentYear} ruichenwei. All rights reserved.</p>
    <ul class="flex items-center gap-4">
      <li>
        <a href="https://github.com/Autoni09" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-text)] transition-colors">
          GitHub
        </a>
      </li>
      <li>
        <a href="/contact" class="hover:text-[var(--color-text)] transition-colors">
          Contact
        </a>
      </li>
      <li>
        <a href="/rss.xml" class="hover:text-[var(--color-text)] transition-colors">
          RSS
        </a>
      </li>
    </ul>
  </div>
</footer>
