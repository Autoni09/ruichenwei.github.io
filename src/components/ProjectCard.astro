---
import Tag from './Tag.astro';

interface Props {
  title: string;
  summary: string;
  slug: string;
  tags: string[];
  date: Date;
  status?: string;
}

const { title, summary, slug, tags, date, status } = Astro.props;

const statusLabel: Record<string, string> = {
  active: 'Active',
  archived: 'Archived',
  experimental: 'Experimental',
};
---

<a href={`/projects/${slug}`} class="block group">
  <article class="p-6 border border-[var(--color-border)] rounded-xl bg-[var(--color-bg-card)] hover:shadow-md transition-shadow">
    <div class="flex items-start justify-between gap-3 mb-3">
      <h3 class="text-lg font-serif font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors">
        {title}
      </h3>
      {status && status !== 'active' && (
        <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--color-bg-muted)] text-[var(--color-text-lighter)] shrink-0">
          {statusLabel[status] || status}
        </span>
      )}
    </div>
    <p class="text-sm text-[var(--color-text-light)] mb-4 line-clamp-2">{summary}</p>
    <div class="flex items-center justify-between">
      <div class="flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map((tag) => <Tag name={tag} />)}
      </div>
      <time class="text-xs text-[var(--color-text-lighter)]" datetime={date.toISOString()}>
        {date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
      </time>
    </div>
  </article>
</a>
