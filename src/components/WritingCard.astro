---
import Tag from './Tag.astro';

interface Props {
  title: string;
  summary: string;
  slug: string;
  tags: string[];
  date: Date;
}

const { title, summary, slug, tags, date } = Astro.props;
---

<a href={`/writing/${slug}`} class="block group">
  <article class="py-5 border-b border-[var(--color-border)] last:border-b-0">
    <div class="flex items-start justify-between gap-4 mb-2">
      <h3 class="text-base font-medium text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors">
        {title}
      </h3>
      <time class="text-xs text-[var(--color-text-lighter)] shrink-0 mt-1" datetime={date.toISOString()}>
        {date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
      </time>
    </div>
    <p class="text-sm text-[var(--color-text-light)] mb-3 line-clamp-2">{summary}</p>
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map((tag) => <Tag name={tag} />)}
      </div>
    )}
  </article>
</a>
