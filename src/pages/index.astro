---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WritingCard from '../components/WritingCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const allWriting = await getCollection('writing', ({ data }) => !data.draft);
const latestWriting = allWriting
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="ruichenwei — Personal Website" description="Personal website of ruichenwei. Exploring AI, productivity, and building tools that matter.">
  <!-- Hero -->
  <section class="pt-16 pb-12">
    <div class="flex flex-col sm:flex-row items-start gap-8 sm:gap-10">
      <!-- Avatar -->
      <div class="shrink-0">
        <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full bg-[var(--color-accent-light)] flex items-center justify-center text-3xl font-serif font-bold text-[var(--color-accent)]">
          R
        </div>
      </div>

      <!-- Text -->
      <div class="flex-1 min-w-0">
        <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[var(--color-text)] mb-2">
          ruichenwei
        </h1>
        <p class="text-base text-[var(--color-text-lighter)] mb-4">
          Building tools at the intersection of AI and productivity.
        </p>
        <p class="text-base text-[var(--color-text-light)] mb-6 leading-relaxed max-w-xl">
          I'm interested in AI, productivity systems, and building small tools that solve real problems.
          I believe in learning by building, and I share what I learn along the way.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-3 mb-6">
          <a href="/projects" class="inline-block px-5 py-2.5 bg-[var(--color-accent)] text-white text-sm font-medium rounded-lg hover:bg-[var(--color-accent-hover)] transition-colors">
            View Projects
          </a>
          <a href="/about" class="inline-block px-5 py-2.5 border border-[var(--color-border)] text-[var(--color-text)] text-sm font-medium rounded-lg hover:bg-[var(--color-bg-muted)] transition-colors">
            About Me
          </a>
        </div>

        <!-- Contact links -->
        <div class="flex items-center gap-4 text-sm text-[var(--color-text-lighter)]">
          <a href="https://github.com/Autoni09" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-text)] transition-colors">
            GitHub
          </a>
          <a href="/contact" class="hover:text-[var(--color-text)] transition-colors">
            Contact
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  {featuredProjects.length > 0 && (
    <section class="py-12 border-t border-[var(--color-border)]">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-serif font-semibold text-[var(--color-text)]">Featured Projects</h2>
        <a href="/projects" class="text-sm text-[var(--color-accent)] hover:underline">All projects →</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            summary={project.data.summary}
            slug={project.id}
            tags={project.data.tags}
            date={project.data.date}
            status={project.data.status}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Latest Writing -->
  {latestWriting.length > 0 && (
    <section class="py-12 border-t border-[var(--color-border)]">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-serif font-semibold text-[var(--color-text)]">Recent Writing</h2>
        <a href="/writing" class="text-sm text-[var(--color-accent)] hover:underline">All writing →</a>
      </div>
      <div>
        {latestWriting.map((post) => (
          <WritingCard
            title={post.data.title}
            summary={post.data.summary}
            slug={post.id}
            tags={post.data.tags}
            date={post.data.date}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Contact CTA -->
  <section class="py-12 border-t border-[var(--color-border)]">
    <div class="p-8 rounded-xl bg-[var(--color-bg-muted)] border border-[var(--color-border)] text-center">
      <h2 class="text-xl font-serif font-semibold text-[var(--color-text)] mb-3">Get in Touch</h2>
      <p class="text-sm text-[var(--color-text-light)] mb-5 max-w-md mx-auto">
        Interested in collaborating or just want to say hello? I'd love to hear from you.
      </p>
      <a href="/contact" class="inline-block px-5 py-2.5 bg-[var(--color-accent)] text-white text-sm font-medium rounded-lg hover:bg-[var(--color-accent-hover)] transition-colors">
        Contact Me
      </a>
    </div>
  </section>
</BaseLayout>
